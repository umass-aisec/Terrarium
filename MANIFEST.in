include LICENSE
include README.md
include pyproject.toml
include pricing.json

recursive-include attack_module *.py
recursive-include envs *.py *.md
recursive-include llm_server *.py
recursive-include src *.py

# Generated environment artifacts should never ship.
recursive-exclude envs/dcops/outputs *

# Exclude research artifacts and vendored dependencies from published sdists.
recursive-exclude experiments *
recursive-exclude external *
recursive-exclude logs *
recursive-exclude dist *
recursive-exclude build *
recursive-exclude .venv *
recursive-exclude .uv_cache *
recursive-exclude .ruff_cache *
recursive-exclude __pycache__ *
recursive-exclude */__pycache__ *
