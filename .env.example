# DO NOT PUT SECRETS IN THIS FILE.
# Copy this template to `.env` and fill in your keys with:
#
#   cp -n .env.example .env
#
# `.env` is gitignored.

# Provider API keys (set what you use).
OPENAI_API_KEY=
GROK_API_KEY=
AI_FOUNDRY_API_KEY=
AI_FOUNDRY_PROJECT_ENDPOINT=
AI_FOUNDRY_RBR_EAST_US_2_PROJECT_ENDPOINT=
AI_FOUNDRY_RBR_EAST_US_2_API_KEY=
AI_FOUNDRY_CLAUDE_OPUS_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# DCOP environments require a CoLLAB checkout.
# If you installed from PyPI (no git submodules), point Terrarium at CoLLAB:
TERRARIUM_COLLAB_PATH=
AI_FOUNDRY_GROK_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
